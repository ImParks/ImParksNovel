{
  "schema": "http://localhost:4000/graphql",
  "documents": [
    "src/**/*.graphql",
    "src/**/*.tsx",
    "src/**/*.ts"
  ],
  "extensions": {
    "endpoints": {
      "development": {
        "url": "http://localhost:4000/graphql",
        "headers": {
          "user-agent": "GraphQL Playground"
        }
      }
    }
  }
}
