# Database
DATABASE_URL=postgresql://username:password@localhost:5432/novel_platform?schema=public

# Application
NODE_ENV=development
PORT=4000

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# AI Integration (optional)
OPENAI_API_KEY=
AI_MODEL=gpt-4

# Payment Gateway (optional)
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_CLIENT_KEY=

# CORS
CORS_ORIGIN=http://localhost:3000

# GraphQL
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
